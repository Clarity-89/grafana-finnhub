{
  "__inputs": [
    {
      "name": "DS_FINNHUB",
      "label": "Finnhub",
      "description": "",
      "type": "datasource",
      "pluginId": "clarity89-finnhub-datasource",
      "pluginName": "Finnhub"
    }
  ],
  "__requires": [
    {
      "type": "datasource",
      "id": "clarity89-finnhub-datasource",
      "name": "Finnhub",
      "version": "0.8.0"
    },
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.1.0"
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "table",
      "name": "Table",
      "version": ""
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    }
  ],
  "uid": "finnhub-stocks",
  "title": "Finnhub stocks",
  "tags": [
    "finnhub",
    "test"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "time": {
    "from": "now-2y",
    "to": "now"
  },
  "refresh": "",
  "templating": {
    "list": [
      {
        "type": "textbox",
        "name": "symbol",
        "label": "Symbol",
        "query": "AAPL",
        "current": {
          "text": "AAPL",
          "value": "AAPL"
        },
        "options": [
          {
            "text": "AAPL",
            "value": "AAPL",
            "selected": true
          }
        ]
      },
      {
        "type": "textbox",
        "name": "stream",
        "label": "Trade stream symbol",
        "query": "BINANCE:BTCUSDT",
        "current": {
          "text": "BINANCE:BTCUSDT",
          "value": "BINANCE:BTCUSDT"
        },
        "options": [
          {
            "text": "BINANCE:BTCUSDT",
            "value": "BINANCE:BTCUSDT",
            "selected": true
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "$symbol quote",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 6
      },
      "datasource": {
        "type": "clarity89-finnhub-datasource",
        "uid": "${DS_FINNHUB}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "clarity89-finnhub-datasource",
            "uid": "${DS_FINNHUB}"
          },
          "type": "quote",
          "symbol": "$symbol",
          "resolution": "D",
          "metric": "price"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^current price$/",
          "values": false
        },
        "textMode": "value",
        "graphMode": "none",
        "colorMode": "value"
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "$symbol profile",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 18,
        "h": 6
      },
      "datasource": {
        "type": "clarity89-finnhub-datasource",
        "uid": "${DS_FINNHUB}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "clarity89-finnhub-datasource",
            "uid": "${DS_FINNHUB}"
          },
          "type": "profile2",
          "symbol": "$symbol",
          "resolution": "D",
          "metric": "price"
        }
      ],
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "reducers": [
              "lastNotNull"
            ],
            "mode": "seriesToRows",
            "includeTimeField": false
          }
        }
      ],
      "options": {
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "$symbol earnings surprises",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "clarity89-finnhub-datasource",
        "uid": "${DS_FINNHUB}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "clarity89-finnhub-datasource",
            "uid": "${DS_FINNHUB}"
          },
          "type": "earnings",
          "symbol": "$symbol",
          "resolution": "D",
          "metric": "price"
        }
      ],
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(period|actual|estimate|surprise)$"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "drawStyle": "points",
            "pointSize": 9,
            "showPoints": "always"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "$stream live trades (websocket)",
      "description": "Streams from Finnhub; crypto symbols trade around the clock.",
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "clarity89-finnhub-datasource",
        "uid": "${DS_FINNHUB}"
      },
      "timeFrom": "5m",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "clarity89-finnhub-datasource",
            "uid": "${DS_FINNHUB}"
          },
          "type": "trades",
          "symbol": "$stream",
          "resolution": "D",
          "metric": "price"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "displayName": "Price",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "$symbol basic financials (price metrics)",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 12
      },
      "datasource": {
        "type": "clarity89-finnhub-datasource",
        "uid": "${DS_FINNHUB}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "clarity89-finnhub-datasource",
            "uid": "${DS_FINNHUB}"
          },
          "type": "metric",
          "symbol": "$symbol",
          "resolution": "D",
          "metric": "price"
        }
      ],
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "reducers": [
              "lastNotNull"
            ],
            "mode": "seriesToRows",
            "includeTimeField": false
          }
        }
      ],
      "options": {
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Field",
            "desc": false
          }
        ]
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "row",
      "title": "Premium endpoints (need a paid Finnhub key)",
      "collapsed": true,
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 1
      },
      "panels": [
        {
          "id": 7,
          "type": "timeseries",
          "title": "$symbol daily candles",
          "gridPos": {
            "x": 0,
            "y": 28,
            "w": 12,
            "h": 9
          },
          "datasource": {
            "type": "clarity89-finnhub-datasource",
            "uid": "${DS_FINNHUB}"
          },
          "targets": [
            {
              "refId": "A",
              "datasource": {
                "type": "clarity89-finnhub-datasource",
                "uid": "${DS_FINNHUB}"
              },
              "type": "candle",
              "symbol": "$symbol",
              "resolution": "D",
              "metric": "price"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "currencyUSD"
            },
            "overrides": [
              {
                "matcher": {
                  "id": "byName",
                  "options": "Traded volume"
                },
                "properties": [
                  {
                    "id": "unit",
                    "value": "short"
                  },
                  {
                    "id": "custom.axisPlacement",
                    "value": "right"
                  },
                  {
                    "id": "custom.drawStyle",
                    "value": "bars"
                  }
                ]
              }
            ]
          },
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom",
              "showLegend": true
            },
            "tooltip": {
              "mode": "multi"
            }
          }
        },
        {
          "id": 8,
          "type": "timeseries",
          "title": "$symbol social sentiment",
          "gridPos": {
            "x": 12,
            "y": 28,
            "w": 12,
            "h": 9
          },
          "datasource": {
            "type": "clarity89-finnhub-datasource",
            "uid": "${DS_FINNHUB}"
          },
          "targets": [
            {
              "refId": "A",
              "datasource": {
                "type": "clarity89-finnhub-datasource",
                "uid": "${DS_FINNHUB}"
              },
              "type": "social-sentiment",
              "symbol": "$symbol",
              "resolution": "D",
              "metric": "price"
            }
          ],
          "fieldConfig": {
            "defaults": {},
            "overrides": []
          },
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom",
              "showLegend": true
            },
            "tooltip": {
              "mode": "multi"
            }
          }
        }
      ]
    }
  ],
  "id": null
}
